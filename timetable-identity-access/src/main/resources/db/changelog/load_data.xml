<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="load_data" author="arsen">
        <loadUpdateData tableName="permission" file="db/data/permissions_data.csv" primaryKey="id">
            <column name="id" type="varchar(40)" header="id"/>
            <column name="name" type="varchar(64)" header="name"/>
            <column name="group" type="varchar(20)" header="group"/>
            <column name="type" type="varchar(20)" header="type"/>
        </loadUpdateData>

        <loadUpdateData tableName="role" file="db/data/roles_data.csv" primaryKey="id">
            <column name="id" type="varchar(40)" header="id"/>
            <column name="name" type="varchar(64)" header="name"/>
            <column name="type" type="varchar(20)" header="type"/>
            <column name="version" type="integer" header="version"/>
        </loadUpdateData>

        <loadData tableName="role_permission" file="db/data/role_permissions_data.csv">
            <column name="role_id" type="varchar(40)" header="role_id"/>
            <column name="permission_id" type="varchar(40)" header="permission_id"/>
        </loadData>

        <loadUpdateData tableName="app_user" file="db/data/users_data.csv" primaryKey="id">
            <column name="id" type="varchar(40)" header="id"/>
            <column name="first_name" type="varchar(64)" header="first_name"/>
            <column name="last_name" type="varchar(64)" header="last_name"/>
            <column name="email" type="varchar(255)" header="email"/>
            <column name="password" type="varchar(255)" header="password"/>
            <column name="type" type="varchar(20)" header="type"/>
            <column name="version" type="integer" header="version"/>
        </loadUpdateData>

        <loadData tableName="user_role" file="db/data/user_roles_data.csv">
            <column name="user_id" type="varchar(40)" header="user_id"/>
            <column name="role_id" type="varchar(40)" header="role_id"/>
        </loadData>
    </changeSet>
</databaseChangeLog>