<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="add_assignment" author="Arsen">
        <createTable tableName="assignment">
            <column name="id" type="varchar(40)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="assignment_pk"/>
            </column>
            <column name="course_id" type="varchar(40)">
                <constraints nullable="false" foreignKeyName="assignment_fk1"
                             referencedTableName="course"
                             referencedColumnNames="id"/>
            </column>
            <column name="title" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="max_grade" type="integer"/>
            <column name="visibility" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="appear_at" type="timestamp(3) with time zone"/>
            <column name="deadline" type="timestamp(3) with time zone"/>
            <column name="type" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="nvarchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp(3) with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="nvarchar(255)"/>
            <column name="last_modified_at" type="timestamp(3) with time zone"/>
        </createTable>

        <createTable tableName="assignment_public_comment">
            <column name="id" type="varchar(40)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="assignment_public_comment_pk"/>
            </column>
            <column name="message" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="assignment_id" type="varchar(40)">
                <constraints nullable="false" foreignKeyName="assignment_public_comment_fk1"
                             referencedTableName="assignment"
                             referencedColumnNames="id"/>
            </column>
            <column name="author_id" type="varchar(40)">
                <constraints nullable="false" foreignKeyName="assignment_public_comment_fk2"
                             referencedTableName="user_snapshot"
                             referencedColumnNames="id"/>
            </column>
            <column name="version" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="nvarchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp(3) with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="nvarchar(255)"/>
            <column name="last_modified_at" type="timestamp(3) with time zone"/>
        </createTable>

        <createTable tableName="assignment_private_comment">
            <column name="id" type="varchar(40)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="assignment_private_comment_pk"/>
            </column>
            <column name="message" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="assignment_id" type="varchar(40)">
                <constraints nullable="false" foreignKeyName="assignment_private_comment_fk1"
                             referencedTableName="assignment"
                             referencedColumnNames="id"/>
            </column>
            <column name="author_id" type="varchar(40)">
                <constraints nullable="false" foreignKeyName="assignment_private_comment_fk2"
                             referencedTableName="user_snapshot"
                             referencedColumnNames="id"/>
            </column>
            <column name="reply_to_user_id" type="varchar(40)">
                <constraints nullable="false" foreignKeyName="assignment_private_comment_fk3"
                             referencedTableName="user_snapshot"
                             referencedColumnNames="id"/>
            </column>
            <column name="version" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="nvarchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp(3) with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="nvarchar(255)"/>
            <column name="last_modified_at" type="timestamp(3) with time zone"/>
        </createTable>

        <createIndex tableName="assignment" indexName="assignment_idx">
            <column name="course_id"/>
        </createIndex>

        <createIndex tableName="assignment_public_comment" indexName="assignment_public_comment_idx1">
            <column name="assignment_id"/>
        </createIndex>
        <createIndex tableName="assignment_public_comment" indexName="assignment_public_comment_idx2">
            <column name="author_id"/>
        </createIndex>

        <createIndex tableName="assignment_private_comment" indexName="assignment_private_comment_idx1">
            <column name="assignment_id"/>
        </createIndex>
        <createIndex tableName="assignment_private_comment" indexName="assignment_private_comment_idx2">
            <column name="author_id"/>
        </createIndex>
        <createIndex tableName="assignment_private_comment" indexName="assignment_private_comment_idx3">
            <column name="reply_to_user_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>